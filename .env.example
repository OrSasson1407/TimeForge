# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend: Firebase Admin SDK ---
# Path to a local Firebase service account JSON key (development only, gitignored).
# Not required when FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST are set below.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=timeforge-dev

# --- Backend: Firebase Emulator Suite (local development / tests) ---
# Set these to run the backend and tests against the local emulators instead of production.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Backend: application config ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Backend: scheduling engine defaults ---
SCHEDULING_TIMEOUT_SECONDS=60
SCHEDULING_RANDOM_SEED=42

# --- Backend: registration email verification (SMTP) ---
# Blank SMTP_USERNAME/SMTP_PASSWORD means "no real provider configured" —
# verification codes are logged to the backend console instead of emailed,
# which is fine for local dev/tests. For real delivery via Gmail: enable
# 2-Step Verification on the sending account, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords) and
# use that here, NOT the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TimeForge

# --- Backend: registration password policy ---
PASSWORD_REQUIRE_SYMBOL=true
# Checks against the HaveIBeenPwned Pwned Passwords API (k-anonymity — no
# API key needed, only a SHA-1 prefix of the password ever leaves this
# process). Best-effort: a network failure allows registration rather than
# blocking on a third party's uptime.
PASSWORD_CHECK_BREACHED=true

# --- Backend: reCAPTCHA v2 (checkbox) on registration ---
# Blank secret key means "no real provider configured" — verification is
# skipped (logged), same dev-fallback shape as the SMTP settings above. Get
# a site/secret key pair at https://www.google.com/recaptcha/admin.
RECAPTCHA_SECRET_KEY=

# --- Frontend (Vite, must be prefixed VITE_ to be exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=timeforge-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=timeforge-dev
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATOR=true
# Public reCAPTCHA site key (safe to expose client-side) — paired with
# RECAPTCHA_SECRET_KEY above. Blank means RegisterPage skips the widget.
VITE_RECAPTCHA_SITE_KEY=
